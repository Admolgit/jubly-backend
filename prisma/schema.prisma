datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  CLIENT
  VENDOR
  ADMIN
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id               String       @id @default(auto()) @map("_id") @db.ObjectId
  email            String       @unique
  password         String?
  firstName        String?
  lastName         String?
  phone            String?
  role             UserRole     @default(VENDOR)
  codeExpiresAt    DateTime?
  verificationCode String?
  refreshTokenHash String?
  isOnline         Boolean?
  lastLogin        DateTime     @default(now())
  provider         AuthProvider @default(EMAIL)
  isVerified       Boolean      @default(false)
  slug             String?
  clientVendorId   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  vendor           Vendor?
  bookings         Booking[]
}

model Vendor {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessName     String
  category         String
  city             String
  state            String
  country          String?
  bio              String?
  services         Service[]
  profileImage     String?
  documentFrontUrl String?
  identityType     String?
  portfolioImages  String[]

  bankAccountNumber  String?
  bankCode           String?
  paystackSubaccount String?
  vendorViews        Int?

  bookings           Booking[]
  vendorAvailability VendorAvailability[]
  transaction        Transaction[]        @relation("Transaction")

  kycStatus           KYCStatus @default(NOT_SUBMITTED)
  isApproved          Boolean   @default(false)
  isActive            Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  VendorBookingSettings VendorBookingSettings?
}

model Service {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  name         String // "Bridal Makeup"
  description  String?
  price        Int // ₦
  durationMins Int? // 120

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  vendorId  String?   @db.ObjectId
  booking   Booking[]

  @@unique([userId, name])
}

model VendorAvailability {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek Int // 0 = Sunday, 6 = Saturday
  startTime String // "09:00"
  endTime   String // "18:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String? @db.ObjectId

  @@unique([vendorId, dayOfWeek])
}

model VendorBookingSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @unique @db.ObjectId

  bufferTime Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])
}

model Booking {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  vendorId   String
  clientId   String?
  serviceId  String
  clientName String?

  date        DateTime // booking day
  startTime   DateTime // "10:00"
  endTime     DateTime // "11:30"
  clientEmail String

  status BookingStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor      Vendor        @relation(fields: [vendorId], references: [id])
  services    Service       @relation(fields: [serviceId], references: [id])
  User        User?         @relation(fields: [userId], references: [id])
  userId      String?       @db.ObjectId
  Transaction Transaction[]
}

model SlotLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId  String   @db.ObjectId
  date      DateTime
  startTime String
  endTime   String
  expiresAt DateTime

  @@unique([vendorId, date, startTime, endTime])
}

model SubAccount {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  paystackAccountId String   @unique
  accountNumber     String
  bankName          String
  accountName       String
  limit             Float?
  isActive          Boolean  @default(true)
  percentageFee     Float    @default(0.05)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SenderDetails {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  vendorId            String        @db.ObjectId
  senderName          String?
  email               String?
  senderAccountNumber String?
  senderBankName      String?
  senderAccountName   String?
  senderDescription   String?
  transactions        Transaction[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Transaction {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  senderDetailsId String?   @db.ObjectId
  vendorId        String    @db.ObjectId
  bookingId       String?
  amount          Float
  currency        String    @default("NGN")
  providerRef     String    @unique
  percentageFee   Float?
  title           String?
  category        String?
  paymentMethod   String?
  status          String    @default("pending")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor        Vendor         @relation("Transaction", fields: [vendorId], references: [id])
  senderDetails SenderDetails? @relation(fields: [senderDetailsId], references: [id])
  booking       Booking?       @relation(fields: [bookingId], references: [id])
}

model vendorCalendar {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  provider     String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  linked       Boolean
}

model Settlement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String   @db.ObjectId
  amount        Float
  transferCode  String?
  recipientCode String?
  status        String
  createdAt     DateTime @default(now())
}
