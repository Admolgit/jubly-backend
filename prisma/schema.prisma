datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum UserRole {
  CLIENT
  VENDOR
  ADMIN
}

enum KYCStatus {
  NOT_SUBMITTED
  PENDING
  APPROVED
  REJECTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  RESCHEDULE_REQUESTED
  CANCELLED_BY_CLIENT
  CANCELLED_BY_VENDOR
}

// Only STANDARD exists today; this is the hook for a future
// vendor-selectable Flexible/Standard/Strict cancellation policy.
enum CancellationPolicyType {
  STANDARD
}

enum RescheduleStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_PROPOSED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}

enum NotificationCategory {
  PAYMENT
  SECURITY
  SYSTEM
  REPORT
}

model User {
  id               String        @id @default(auto()) @map("_id") @db.ObjectId
  email            String        @unique
  password         String?
  firstName        String?
  lastName         String?
  phone            String?
  role             UserRole      @default(VENDOR)
  codeExpiresAt    DateTime?
  verificationCode String?
  refreshTokenHash String?
  isOnline         Boolean?
  lastLogin        DateTime      @default(now())
  provider         AuthProvider  @default(EMAIL)
  isVerified       Boolean       @default(false)
  slug             String?
  isSuspended      Boolean       @default(false)
  clientVendorId   String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  vendor           Vendor?
  bookings         Booking[]
  ActivityLog      ActivityLog[]
}

model Vendor {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  businessName     String
  category         String
  city             String
  state            String
  country          String?
  bio              String?
  services         Service[]
  profileImage     String?
  documentFrontUrl String?
  identityType     String?
  portfolioImages  String[]

  bankAccountNumber  String?
  bankCode           String?
  paystackSubaccount String?
  vendorViews        Int?

  // Number of bookings this vendor has cancelled (as opposed to the client) —
  // vendor-initiated cancellations always fully refund the client.
  cancellationStrikes Int @default(0)

  bookings           Booking[]
  vendorAvailability VendorAvailability[]
  transaction        Transaction[]        @relation("Transaction")

  kycStatus           KYCStatus @default(NOT_SUBMITTED)
  isApproved          Boolean   @default(false)
  isActive            Boolean   @default(false)
  onboardingCompleted Boolean   @default(false)

  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  VendorBookingSettings VendorBookingSettings?
  ActivityLog           ActivityLog[]
}

model Service {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId

  name         String // "Bridal Makeup"
  description  String?
  price        Int // ₦
  durationMins Int? // 120

  active Boolean @default(true)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  Vendor    Vendor?   @relation(fields: [vendorId], references: [id])
  vendorId  String?   @db.ObjectId
  booking   Booking[]

  @@unique([userId, name])
}

model VendorAvailability {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  dayOfWeek Int // 0 = Sunday, 6 = Saturday
  startTime String // "09:00"
  endTime   String // "18:00"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor   Vendor? @relation(fields: [vendorId], references: [id])
  vendorId String? @db.ObjectId

  @@unique([vendorId, dayOfWeek])
}

model VendorBookingSettings {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  vendorId String @unique @db.ObjectId

  bufferTime Int @default(0)

  cancellationPolicy CancellationPolicyType @default(STANDARD)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor Vendor @relation(fields: [vendorId], references: [id])
}

model Booking {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  vendorId      String
  clientId      String?
  name          String
  googleEventId String?
  serviceId     String
  clientName    String?
  clientAddress String?

  date        DateTime // booking day
  startTime   DateTime // "10:00"
  endTime     DateTime // "11:30"
  clientEmail String

  status BookingStatus @default(PENDING)

  // Cancellation audit
  cancelledBy        String? // userId of whoever cancelled (client or vendor)
  cancelledByRole    UserRole?
  cancelledAt        DateTime?
  cancellationReason String?

  // Cancellation penalty outcome, computed from the applicable policy at cancellation time
  cancellationTier             String?
  refundPercentage             Float?
  vendorCompensationPercentage Float?
  refundAmount                 Float?
  vendorCompensationAmount     Float?

  // A booking may only be rescheduled once unless an admin overrides it
  rescheduleCount Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendor             Vendor              @relation(fields: [vendorId], references: [id])
  services           Service             @relation(fields: [serviceId], references: [id])
  user               User?               @relation(fields: [userId], references: [id])
  userId             String?             @db.ObjectId
  Transaction        Transaction[]
  rescheduleRequests RescheduleRequest[]
}

model RescheduleRequest {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  bookingId String  @db.ObjectId
  booking   Booking @relation(fields: [bookingId], references: [id])

  // Who opened this request/counter-proposal
  initiatedBy     String   @db.ObjectId
  initiatedByRole UserRole

  proposedDate DateTime

  // The previously proposed date this row counter-proposes against, if any
  previousProposedDate DateTime?

  reason String?

  status RescheduleStatus @default(PENDING)

  // Booking.status at the moment this request was opened, so it can be
  // restored if the request is rejected or otherwise closed without a date change
  bookingStatusBeforeRequest BookingStatus

  // Who accepted/rejected/countered this request
  respondedBy    String?   @db.ObjectId
  respondedAt    DateTime?
  responseReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

model SlotLock {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  vendorId  String   @db.ObjectId
  date      DateTime
  startTime String
  endTime   String
  expiresAt DateTime

  @@unique([vendorId, date, startTime, endTime])
}

model SubAccount {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  paystackAccountId String   @unique
  accountNumber     String
  bankName          String
  accountName       String
  limit             Float?
  isActive          Boolean  @default(true)
  percentageFee     Float    @default(0.05)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model SenderDetails {
  id                  String        @id @default(auto()) @map("_id") @db.ObjectId
  vendorId            String        @db.ObjectId
  senderName          String?
  email               String?
  senderAccountNumber String?
  senderBankName      String?
  senderAccountName   String?
  senderDescription   String?
  transactions        Transaction[]
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
}

model Transaction {
  id              String    @id @default(auto()) @map("_id") @db.ObjectId
  senderDetailsId String?   @db.ObjectId
  vendorId        String    @db.ObjectId
  bookingId       String?
  amount          Float
  currency        String    @default("NGN")
  providerRef     String    @unique
  percentageFee   Float?
  title           String?
  category        String?
  paymentMethod   String?
  status          String    @default("pending")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  vendor        Vendor         @relation("Transaction", fields: [vendorId], references: [id])
  senderDetails SenderDetails? @relation(fields: [senderDetailsId], references: [id])
  booking       Booking?       @relation(fields: [bookingId], references: [id])
}

model vendorCalendar {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  userId       String   @unique @db.ObjectId
  provider     String
  accessToken  String
  refreshToken String
  expiryDate   DateTime
  linked       Boolean
}

model Settlement {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  bookingId     String   @db.ObjectId
  amount        Float
  transferCode  String?
  recipientCode String?
  status        String
  createdAt     DateTime @default(now())
}

model Enquiry {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NotificationSettings {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  userId             String   @unique @db.ObjectId
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  pushNotifications  Boolean  @default(true)
  bookingDigest      String   @default("EVERY_MORNING")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Notification {
  id        String               @id @default(auto()) @map("_id") @db.ObjectId
  userId    String               @db.ObjectId
  title     String
  message   String
  type      NotificationType     @default(INFO)
  category  NotificationCategory
  isRead    Boolean              @default(false)
  readAt    DateTime?
  data      Json?
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
}

model ActivityLog {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  userId   String? @db.ObjectId
  vendorId String? @db.ObjectId

  action      String
  description String

  actor     String
  actorType ActivityActorType
  color     String?

  metadata Json?

  createdAt DateTime @default(now())

  user   User?   @relation(fields: [userId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([userId])
  @@index([vendorId])
  @@index([createdAt])
}

enum ActivityActorType {
  SYSTEM
  CLIENT
  VENDOR
  ADMIN
}
